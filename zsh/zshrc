# -------------------------------------
# 環境変数
# -------------------------------------
export LANG=ja_JP.UTF-8
export EDITOR=vim
export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"

# ls 時の色を設定する
export CLICOLOR=true
export LSCOLORS='gxfxbEaEBxxEhEhBaDaCaD'
export LS_COLORS='di=36:ln=35:so=31;1;44:pi=30;1;44:ex=1;31:bd=0;1;44:cd=37;1;44:su=37;1;41:sg=30;1;43:tw=30;1;42:ow=36;1;42:'

# disable CLAUDE_CODE_TIPS 
export DISABLE_NON_ESSENTIAL_MODEL_CALLS=1

# -------------------------------------
# zplug
# -------------------------------------
export ZPLUG_HOME=/opt/homebrew/opt/zplug
source $ZPLUG_HOME/init.zsh

zplug 'zsh-users/zsh-completions', use:'src/_*', lazy:true
zplug "mafredri/zsh-async", on:sindresorhus/pure
zplug "sindresorhus/pure", use:pure.zsh
zplug "zsh-users/zsh-syntax-highlighting"
zplug "zsh-users/zsh-autosuggestions"
zplug "mollifier/cd-gitroot"

if ! zplug check --verbose; then
  printf 'Install? [y/N]: '
  if read -q; then
    echo; zplug install
  fi
fi

zplug load

ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20

# -------------------------------------
# zshオプション
# -------------------------------------
autoload -Uz compinit && compinit -u

setopt auto_list
setopt auto_menu
setopt print_eight_bit
setopt no_beep
setopt no_hist_beep
setopt no_list_beep
setopt notify
setopt interactive_comments

# ヒストリ
HISTFILE=~/.zsh_history
HISTSIZE=1000000
SAVEHIST=1000000
setopt share_history
setopt hist_ignore_dups
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_reduce_blanks

# -------------------------------------
# 補完
# -------------------------------------
zstyle ':completion:*' completer _complete _match _approximate
zstyle ':completion:*' group-name ''
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' use-cache true
zstyle ':completion:*' verbose yes
zstyle ':completion:*:default' menu select=2
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:options' description 'yes'

# -------------------------------------
# パス
# -------------------------------------
typeset -U path cdpath fpath manpath

path=(
    $HOME/bin(N-/)
    $path
)

# -------------------------------------
# Go
# -------------------------------------
if [ -x "`which go`" ]; then
    export GOPATH=$HOME/.go
    export PATH=$PATH:$GOPATH/bin
fi

# -------------------------------------
# peco
# -------------------------------------
export _ENHANCD_FILTER=peco

function peco_select_history() {
    local tac
    if which tac > /dev/null; then
        tac="tac"
    else
        tac="tail -r"
    fi
    BUFFER=$(\history -n 1 | \
        eval $tac | \
        peco --query "$LBUFFER")
    CURSOR=$#BUFFER
    zle clear-screen
}
zle -N peco_select_history

function peco_src() {
    local src_dir=$(ghq list --full-path | peco --query "$LBUFFER")
    if [ -n "$src_dir" ]; then
        BUFFER="cd \"$src_dir\""
        zle accept-line
    fi
    zle -R -c
}
zle -N peco_src

function p() {
    local src_dir=$(ghq list --full-path | peco)
    if [ -n "$src_dir" ]; then
        cd "$src_dir"
    fi
}

function ccc() {
    local src_dir=$(ghq list --full-path | peco --query "$LBUFFER")
    if [ -n "$src_dir" ]; then
        cd "$src_dir" && claude --dangerously-skip-permissions
    fi
}

function ccr() {
    local src_dir=$(ghq list --full-path | peco --query "$LBUFFER")
    if [ -n "$src_dir" ]; then
        cd "$src_dir" && claude -r --fork-session --dangerously-skip-permissions
    fi
}

function k() {
    cd "$HOME/ghq/github.com/co-cre/kajinuma-os" && claude --dangerously-skip-permissions
}

function kc() {
    cd "$HOME/ghq/github.com/co-cre/kajinuma-os" && claude --dangerously-skip-permissions
}

function kr() {
    cd "$HOME/ghq/github.com/co-cre/kajinuma-os" && claude -r --fork-session --dangerously-skip-permissions
}

# -------------------------------------
# キーバインド
# -------------------------------------
bindkey -e
bindkey '^r' peco_select_history
bindkey '^]' peco_src

# -------------------------------------
# エイリアス
# -------------------------------------
alias ll="ls -la"
alias la="ls -la"
alias g="git"
alias cdg="cd-gitroot"
alias z="source ~/.zshrc"
alias cr="cursor"
alias -g C='| pbcopy'
alias y='yazi'
alias gp='git add -A && expect -c '"'"'spawn aicommits -a; expect "Yes"; send "\r"; expect eof'"'"' && git push origin $(git rev-parse --abbrev-ref HEAD)'
alias c='claude --dangerously-skip-permissions'
alias cr='claude -r --fork-session --dangerously-skip-permissions'
alias cx='codex --dangerously-bypass-approvals-and-sandbox'
alias cxr='codex --dangerously-bypass-approvals-and-sandbox resume'
alias M='ssh macmini'
function m() {
    ssh -t macmini 'zsh -ic k'
}
function mr() {
    ssh -t macmini 'zsh -ic kr'
}
function macmini-fwd() {
    local port=${1:-5500}
    ssh -L "${port}:localhost:${port}" macmini
}

function chpwd() { ls }

# -------------------------------------
# git-wt
# -------------------------------------
eval "$(git wt --init zsh)"

function peco_wt() {
    local wt=$(git wt list 2>/dev/null | peco --query "$LBUFFER")
    if [ -n "$wt" ]; then
        BUFFER="cd \"$wt\""
        zle accept-line
    fi
    zle -R -c
}
zle -N peco_wt
bindkey '^w' peco_wt

