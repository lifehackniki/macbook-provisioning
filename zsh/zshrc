# zplug
# -------------------------------------
export ZPLUG_HOME=/opt/homebrew/opt/zplug
source $ZPLUG_HOME/init.zsh

zplug 'zsh-users/zsh-completions', use:'src/_*', lazy:true
zplug "zsh-users/zsh-syntax-highlighting"
zplug "zsh-users/zsh-autosuggestions"
zplug "mollifier/cd-gitroot"

if ! zplug check --verbose; then
  printf 'Install? [y/N]: '
  if read -q; then
    echo; zplug install
  fi
fi

zplug load

# -------------------------------------
# プロンプト（絵文字 + カレントディレクトリ名）
# -------------------------------------
case "${(L)HOST}" in
    *macbook*|*mba*|*air*) _prompt_emoji='💻' ;;
    *macmini*|*mini*)      _prompt_emoji='🖥️' ;;
    *)                     _prompt_emoji='%m' ;;
esac

# ホスト名の部分一致で略称ラベルを表示（一致しなければ非表示）
case "${(L)HOST}" in
    *macbook*|*mba*|*air*) _prompt_label='MBA ' ;;
    *macmini*|*mac-mini*|*mini*) _prompt_label='Mini ' ;;
    *) _prompt_label='' ;;
esac

PROMPT="${_prompt_label}${_prompt_emoji} [%1~]"$'\n'"❯ "

ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20

# -------------------------------------
# zshオプション
# -------------------------------------
autoload -Uz compinit && compinit -u

setopt auto_list
setopt auto_menu
setopt print_eight_bit
setopt no_beep
setopt no_hist_beep
setopt no_list_beep
setopt notify
setopt interactive_comments

# ヒストリ
HISTFILE=~/.zsh_history
HISTSIZE=1000000
SAVEHIST=1000000
setopt share_history
setopt hist_ignore_dups
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_reduce_blanks

# -------------------------------------
# 補完
# -------------------------------------
zstyle ':completion:*' completer _complete _match _approximate
zstyle ':completion:*' group-name ''
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' use-cache true
zstyle ':completion:*' verbose yes
zstyle ':completion:*:default' menu select=2
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:options' description 'yes'

# -------------------------------------
# パス
# -------------------------------------
typeset -U path cdpath fpath manpath

path=(
    $HOME/bin(N-/)
    $path
)

# -------------------------------------
# Go
# -------------------------------------
if [ -x "`which go`" ]; then
    export GOPATH=$HOME/.go
    export PATH=$PATH:$GOPATH/bin
fi

# -------------------------------------
# peco
# -------------------------------------
export _ENHANCD_FILTER=peco

function peco_select_history() {
    local tac
    if which tac > /dev/null; then
        tac="tac"
    else
        tac="tail -r"
    fi
    BUFFER=$(\history -n 1 | \
        eval $tac | \
        peco --query "$LBUFFER")
    CURSOR=$#BUFFER
    zle clear-screen
}
zle -N peco_select_history

function peco_src() {
    local src_dir=$(ghq list --full-path | peco --query "$LBUFFER")
    if [ -n "$src_dir" ]; then
        BUFFER="cd \"$src_dir\""
        zle accept-line
    fi
    zle -R -c
}
zle -N peco_src

function p() {
    local src_dir=$(ghq list --full-path | peco)
    if [ -n "$src_dir" ]; then
        cd "$src_dir"
    fi
}

_claude='claude --dangerously-skip-permissions'
_claude_r='claude -r --fork-session --dangerously-skip-permissions'
_codex='codex --dangerously-bypass-approvals-and-sandbox'
_codex_r='codex --dangerously-bypass-approvals-and-sandbox resume'

_pick() { ghq list --full-path | peco --query "$LBUFFER" }
pc()  { local d=$(_pick); [ -n "$d" ] && cd "$d" && eval "$_claude"   }
pcr() { local d=$(_pick); [ -n "$d" ] && cd "$d" && eval "$_claude_r" }
px()  { local d=$(_pick); [ -n "$d" ] && cd "$d" && eval "$_codex"    }
pxr() { local d=$(_pick); [ -n "$d" ] && cd "$d" && eval "$_codex_r"  }

_kj() { cd "$HOME/ghq/github.com/co-cre/kajinuma-os" }
kc()  { _kj && eval "$_claude"   }
kcr() { _kj && eval "$_claude_r" }
kx()  { _kj && eval "$_codex"    }
kxr() { _kj && eval "$_codex_r"  }
alias k=kc

# -------------------------------------
# キーバインド
# -------------------------------------
bindkey -e
bindkey '^r' peco_select_history
bindkey '^]' peco_src

